{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset Renovate partagé (GLB-008). Usage : { \"extends\": [\"github>soodidi/shared-libs\"] }",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests",
    ":maintainLockFilesWeekly"
  ],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "automerge": true,
  "packageRules": [
    {
      "description": "Regrouper les mises à jour par écosystème",
      "matchPackageNames": ["/^@nestjs\\//"],
      "groupName": "nestjs"
    },
    {
      "matchPackageNames": ["/^@tanstack\\//"],
      "groupName": "tanstack"
    },
    {
      "matchPackageNames": ["/^@sentry\\//"],
      "groupName": "sentry"
    },
    {
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "/^eslint-/",
        "/^@typescript-eslint\\//"
      ],
      "groupName": "eslint"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Majeures : une PR par paquet, étiquetée pour rester repérable (fusion automatique si la CI est verte, GLB-011)",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major"]
    }
  ]
}
